# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project details

# Application database. LAYERBASE_DATABASE_URL takes precedence when both are set.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
LAYERBASE_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Only needed while migrating from Supabase.
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-app-id
VITE_OPENCASELIST_COLLECTION=ndtceda26
VITE_API_URL=http://localhost:8080
VITE_LOCAL_API_URL=http://localhost:8081
VITE_ADMIN_API_URL=http://localhost:8081
